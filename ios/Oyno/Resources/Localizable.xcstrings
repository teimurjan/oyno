    "Every round and every minute grow it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Runde und jede Minute lassen ihn wachsen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada partida y cada minuto lo hacen crecer."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crece con cada ronda y cada minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque partie et chaque minute la font grandir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cresce con ogni partita e ogni minuto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk rondje en elke minuut laten hem groeien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rośnie z każdą rundą i każdą minutą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada rodada e cada minuto fazem o planeta crescer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Она растёт с каждым раундом и каждой минутой."
          }
        }
      }
    },
    "Every round together blooms your family's little planet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede gemeinsame Runde lässt den kleinen Planeten deiner Familie aufblühen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada partida en familia hace florecer vuestro pequeño planeta."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada ronda que juegan juntos hace florecer el pequeño planeta de tu familia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque partie jouée ensemble fait fleurir la petite planète de votre famille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni partita insieme fa fiorire il piccolo pianeta della tua famiglia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk rondje samen laat de kleine planeet van je gezin opbloeien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z każdą wspólną rundą mała planeta twojej rodziny rozkwita."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada rodada juntos faz florescer o planetinha da sua família."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С каждым раундом маленькая планета вашей семьи расцветает."
          }
        }
      }
    },
    "Every world is yours" : {
