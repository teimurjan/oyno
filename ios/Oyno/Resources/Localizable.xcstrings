    "Facebook couldn't complete that. Try again, or use another way in." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook to nedokázal dokončit. Zkus to znovu, nebo se přihlas jinak."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook kunne ikke gennemføre det. Prøv igen, eller log ind på en anden måde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook konnte das nicht abschließen. Versuche es noch einmal oder melde dich anders an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook no ha podido completarlo. Inténtalo de nuevo, o entra de otra forma."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook no pudo completarlo. Inténtalo de nuevo, o entra de otra forma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook ei saanut sitä valmiiksi. Yritä uudelleen tai kirjaudu toisella tavalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook n’a pas pu finaliser. Réessayez, ou connectez-vous autrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook non è riuscito a completare l’operazione. Riprova, oppure accedi in un altro modo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook fikk ikke fullført. Prøv igjen, eller logg på på en annen måte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook kon dat niet afronden. Probeer het opnieuw, of log op een andere manier in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook nie zdołał tego dokończyć. Spróbuj ponownie albo zaloguj się inaczej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Facebook não conseguiu concluir. Tente de novo, ou entre de outro jeito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Facebook não conseguiu concluir. Tente de novo, ou entre de outra forma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook не смог выполнить вход. Попробуйте ещё раз или войдите другим способом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook kunde inte slutföra det. Försök igen, eller logga in på ett annat sätt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook bunu tamamlayamadı. Tekrar deneyin ya da başka bir yolla girin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facebook не зміг завершити вхід. Спробуйте ще раз або увійдіть іншим способом."
          }
        }
      }
    },
