    "One tap opens tonight's game. iOS only lets the nudge through if you allow it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tippen öffnet das Spiel für heute Abend. iOS lässt die Erinnerung nur durch, wenn du es erlaubst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un toque y se abre el juego de hoy. iOS solo deja pasar el aviso si lo permites."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un toque abre el juego de hoy. iOS solo deja pasar el aviso si lo permites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un simple toucher ouvre le jeu du soir. iOS ne laisse passer le rappel que si vous l’autorisez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tocco apre il gioco di stasera. iOS mostra il promemoria solo se lo consenti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén tik en het spelletje van vanavond staat klaar. iOS laat het seintje alleen door als jij het toestaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno dotknięcie i wieczorna zabawa gotowa. iOS pokaże przypomnienie tylko za twoją zgodą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um toque abre a brincadeira de hoje. O iOS só mostra o lembrete se você permitir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно касание — и игра на вечер открыта. iOS покажет напоминание, только если вы разрешите."
          }
        }
      }
    },
