{
  "sourceLanguage" : "en",
  "strings" : {
    "…and counting on your little planet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…und dein kleiner Planet zählt weiter mit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…y sumando en tu pequeño planeta."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…y sumando en tu pequeño planeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…et ça continue sur votre petite planète."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…e il conto sale sul tuo piccolo pianeta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…en de teller op je kleine planeet loopt door."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…a licznik na twojej małej planecie wciąż rośnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…e contando, no seu planetinha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…и счёт на вашей маленькой планете растёт."
          }
        }
      }
    },
    "“Oyno” Would Like to Access Screen Time" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Oyno“ möchte auf die Bildschirmzeit zugreifen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app Oyno quiere acceder a “Tiempo de uso”"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyno quiere acceder a Tiempo en pantalla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Oyno » souhaite accéder à Temps d’écran"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyno vorrebbe accedere a “Tempo di utilizzo”"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyno wil toegang tot 'Schermtijd'"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Oyno” chce uzyskać dostęp do Czasu przed ekranem"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Oyno” Deseja Acessar o Tempo de Uso"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение «Oyno» запрашивает доступ к Экранному времени"
          }
        }
      }
    },
    "“Oyno” Would Like to Send You Notifications" : {
