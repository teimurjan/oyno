    "Prints already costed against it keep their numbers. Only the machine goes." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tisky už na ni naceněné si čísla nechají. Zmizí jen stroj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Print, der allerede er beregnet på den, beholder deres tal. Kun maskinen forsvinder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits damit kalkulierte Drucke behalten ihre Zahlen. Nur die Maschine verschwindet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las impresiones ya calculadas con ella conservan sus números. Solo se va la máquina."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las impresiones ya calculadas con ella conservan sus números. Solo se va la máquina."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sille jo lasketut tulostukset säilyttävät lukunsa. Vain kone lähtee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les impressions déjà chiffrées dessus gardent leurs chiffres. Seule la machine part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stampe già calcolate su di lei mantengono i loro numeri. Se ne va solo la macchina."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utskrifter som allerede er beregnet mot den, beholder tallene sine. Bare maskinen forsvinner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prints die er al mee zijn doorgerekend, houden hun cijfers. Alleen de machine gaat weg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydruki już policzone na niej zachowują swoje liczby. Znika tylko maszyna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As impressões já calculadas nela mantêm os números. Só a máquina sai."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As impressões já calculadas com ela mantêm os seus números. Só a máquina desaparece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже рассчитанные по нему печати сохранят свои цифры. Удалится только принтер."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utskrifter som redan kostnadsberäknats mot den behåller sina siffror. Bara maskinen försvinner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onunla hesaplanmış baskılar rakamlarını korur. Yalnızca makine gider."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже розраховані по ньому друки збережуть свої цифри. Видалиться лише принтер."
          }
        }
      }
    },
    "Prints already logged against it keep their costs. Only the roll goes." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tisky už na ni zapsané si náklady nechají. Zmizí jen role."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Print, der allerede er registreret på den, beholder deres omkostninger. Kun rullen forsvinder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits damit erfasste Drucke behalten ihre Kosten. Nur die Rolle verschwindet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las impresiones ya registradas con ella conservan sus costes. Solo se va la bobina."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las impresiones ya registradas con él conservan sus costos. Solo se va el rollo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sille jo kirjatut tulostukset säilyttävät kustannuksensa. Vain rulla lähtee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les impressions déjà enregistrées dessus gardent leurs coûts. Seule la bobine part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stampe già registrate su di lei mantengono i loro costi. Se ne va solo la bobina."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utskrifter som allerede er ført mot den, beholder kostnadene sine. Bare rullen forsvinner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prints die er al mee zijn vastgelegd, houden hun kosten. Alleen de rol gaat weg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydruki już zapisane na niej zachowują swoje koszty. Znika tylko rolka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As impressões já registradas nela mantêm os custos. Só o rolo sai."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As impressões já registadas com ela mantêm os seus custos. Só o rolo desaparece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже записанные по ней печати сохранят свою себестоимость. Удалится только катушка."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utskrifter som redan loggats mot den behåller sina kostnader. Bara rullen försvinner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onunla kaydedilmiş baskılar maliyetlerini korur. Yalnızca rulo gider."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже записані по ній друки збережуть свою собівартість. Видалиться лише котушка."
          }
        }
      }
    },
