    "Your rounds and your planet go with it. This cannot be undone. An active subscription keeps running until you cancel it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Runden und dein Planet werden mitgelöscht. Das lässt sich nicht rückgängig machen. Ein aktives Abo läuft weiter, bis du es kündigst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus partidas y tu planeta se borran con ella. No se puede deshacer. Si tienes una suscripción activa, seguirá en marcha hasta que la canceles."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus rondas y tu planeta se borran con ella. Esto no se puede deshacer. Si tienes una suscripción activa, sigue vigente hasta que la canceles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos parties et votre planète disparaissent avec lui. C’est irréversible. Un abonnement actif continue tant que vous ne l’annulez pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con l’account se ne vanno anche le tue partite e il tuo pianeta. Non si può tornare indietro. Un abbonamento attivo continua finché non lo disdici."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je rondjes en je planeet verdwijnen dan ook. Dit kun je niet ongedaan maken. Een actief abonnement loopt door tot je het opzegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razem z nim znikną twoje rundy i planeta. Tego nie da się cofnąć. Aktywna subskrypcja działa dalej, dopóki jej nie anulujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas rodadas e seu planeta vão junto. Não dá para desfazer. Uma assinatura ativa continua até você cancelar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместе с ним удалятся раунды и планета. Это действие нельзя отменить. Активная подписка продолжит действовать, пока вы её не отмените."
          }
        }
      }
    },
