    "Your account is still here — that didn't go through. Try again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvůj účet tu pořád je — tohle neprošlo. Zkus to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din konto er her stadig — det gik ikke igennem. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto ist noch da — das hat nicht geklappt. Versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta sigue ahí: eso no ha salido. Inténtalo de nuevo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta sigue ahí: eso no salió. Inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilisi on yhä tallella — se ei mennyt läpi. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte est toujours là — ça n’a pas abouti. Réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account è ancora qui: non è andata a buon fine. Riprova."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoen din er her fortsatt — det gikk ikke gjennom. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account staat er nog — dat is niet gelukt. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto nadal jest — to się nie udało. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta continua aqui — não deu certo. Tente de novo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua conta continua cá — isso não foi por diante. Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт на месте — удалить не получилось. Попробуйте ещё раз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt konto finns kvar — det gick inte igenom. Försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınız hâlâ duruyor — bu işlem geçmedi. Tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акаунт на місці — видалити не вдалося. Спробуйте ще раз."
          }
        }
      }
    },
    "Your currency, grid price and what an hour of your time is worth." : {
      "localizations" : {
        "cs" : {
