    "%@ is paused for Kid hours. Your kid gets you instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist während der Familienzeit pausiert. Dafür hat dein Kind jetzt dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en pausa por el Tiempo en familia. Ahora tu peque te tiene a ti."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en pausa durante el Tiempo en familia. Ahora tu peque te tiene a ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est en pause pendant le Temps en famille. Place à votre enfant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è in pausa durante il Tempo in famiglia. Al suo posto, il tuo piccolo ha te."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is gepauzeerd tijdens Gezinstijd. Nu krijgt je kind jou."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ma przerwę, bo trwa Czas z dzieckiem. Za to dziecko ma ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está pausado no Tempo em família. Agora a vez é do seu filho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ на паузе — идёт Детское время. Вместо него у ребёнка есть вы."
          }
        }
      }
    },
