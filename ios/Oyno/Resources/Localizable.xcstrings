    "Quotes already costed against it keep their numbers. Only the item goes." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalkulace, které s ním už počítaly, si čísla nechají. Zmizí jen položka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbud, der allerede er beregnet med den, beholder deres tal. Kun varen forsvinder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalkulationen, die es bereits enthalten, behalten ihre Zahlen. Nur der Posten verschwindet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los presupuestos ya calculados con él conservan sus números. Solo se va el artículo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cotizaciones ya calculadas con él conservan sus números. Solo se va el artículo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen kanssa jo lasketut tarjoukset säilyttävät lukunsa. Vain nimike lähtee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les devis déjà chiffrés avec gardent leurs chiffres. Seul l’article part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I preventivi già calcolati con esso mantengono i loro numeri. Se ne va solo l’articolo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbud som allerede er regnet med den, beholder tallene sine. Bare varen forsvinner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offertes waarin het al is doorgerekend, houden hun cijfers. Alleen het artikel gaat weg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyceny już policzone z nim zachowują swoje liczby. Znika tylko pozycja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os orçamentos já calculados com ele mantêm os números. Só o item sai."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os orçamentos já calculados com ele mantêm os seus números. Só o artigo desaparece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже рассчитанные с ним расчёты сохранят свои цифры. Удалится только расходник."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offerter som redan räknats med den behåller sina siffror. Bara artikeln försvinner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onunla hesaplanmış teklifler rakamlarını korur. Yalnızca kalem gider."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже розраховані з ним розрахунки збережуть свої цифри. Видалиться лише позиція."
