    "Apple couldn't complete that. Check that an Apple Account is signed in under iOS Settings, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple konnte das nicht abschließen. Prüfe in den iOS-Einstellungen, ob du mit einem Apple Account angemeldet bist, und versuch es dann noch mal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
