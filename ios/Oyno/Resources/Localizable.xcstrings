    "Nothing else goes with it — no filament was ever deducted for a quote." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic dalšího s tím nezmizí — u kalkulace se filament nikdy neodepisoval."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der følger ikke andet med — der er aldrig trukket filament for et tilbud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonst geht nichts mit verloren — für eine Kalkulation wurde nie Filament abgebucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se va nada más: por un presupuesto nunca se descontó filamento."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se va nada más: por una cotización nunca se descontó filamento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitään muuta ei lähde mukana — tarjouksesta ei ole koskaan vähennetty filamenttia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien d’autre ne part avec : aucun filament n’a jamais été décompté pour un devis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non se ne va nient’altro: per un preventivo non è mai stato scalato del filamento."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting annet følger med — for et tilbud er det aldri trukket filament."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er gaat verder niets mee — voor een offerte is nooit filament afgeboekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic więcej z tym nie zniknie: przy wycenie filament nigdy nie był zdejmowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada mais vai junto: por um orçamento nunca foi descontado filamento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não vai mais nada — por um orçamento nunca foi descontado filamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше ничего не пропадёт: по расчёту филамент никогда не списывался."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget annat följer med — för en offert har det aldrig dragits något filament."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir şey gitmez: bir teklif için hiçbir zaman filament düşülmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Більше нічого не зникне: за розрахунком філамент ніколи не списувався."
          }
        }
      }
    },
    "Nothing here yet — drop a roll on it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím nic — přetáhněte sem cívku."
          }
