    "Syncing needs an active subscription. Everything you've entered is still on this device." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizace vyžaduje aktivní předplatné. Všechno, co jsi zadal, je pořád na tomhle zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering kræver et aktivt abonnement. Alt, hvad du har tastet ind, ligger stadig på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Synchronisierung ist ein aktives Abo nötig. Alles, was du eingegeben hast, liegt weiterhin auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizar requiere una suscripción activa. Todo lo que has introducido sigue en este dispositivo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizar requiere una suscripción activa. Todo lo que capturaste sigue en este dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronointi vaatii voimassa olevan tilauksen. Kaikki syöttämäsi on yhä tällä laitteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation demande un abonnement actif. Tout ce que vous avez saisi est toujours sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione richiede un abbonamento attivo. Tutto quello che hai inserito è ancora su questo dispositivo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering krever et aktivt abonnement. Alt du har lagt inn ligger fortsatt på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchroniseren vraagt een lopend abonnement. Alles wat je hebt ingevoerd, staat nog op dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja wymaga aktywnej subskrypcji. Wszystko, co wpisałeś, nadal jest na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizar exige uma assinatura ativa. Tudo que você digitou continua neste aparelho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização exige uma subscrição ativa. Tudo o que introduziu continua neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для синхронизации нужна активная подписка. Всё, что вы ввели, осталось на этом устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkning kräver en aktiv prenumeration. Allt du har matat in finns kvar på den här enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşitleme için etkin bir abonelik gerekir. Girdiğiniz her şey hâlâ bu cihazda."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для синхронізації потрібна активна підписка. Усе, що ви ввели, залишилося на цьому пристрої."
          }
        }
      }
    },
