    "Saving this puts %@ back on the rolls these lines name. You'll be asked before it does." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložení vrátí %@ na role, které tyhle položky jmenují. Předtím se tě aplikace zeptá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At gemme lægger %@ tilbage på de ruller, linjerne peger på. Du bliver spurgt først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern bucht %@ zurück auf die Rollen, die diese Positionen nennen. Du wirst vorher gefragt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al guardar se devuelven %@ a las bobinas que nombran estas líneas. Se te preguntará antes de hacerlo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al guardar se devuelven %@ a los rollos que nombran estas líneas. Se te preguntará antes de hacerlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennus palauttaa %@ niille rullille, jotka nämä rivit nimeävät. Sinulta kysytään ensin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement remet %@ sur les bobines nommées par ces lignes. On vous demandera confirmation avant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvando rimetti %@ sulle bobine indicate da queste righe. Ti verrà chiesto prima di farlo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å lagre legger %@ tilbake på rullene linjene peker på. Du blir spurt først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opslaan zet %@ terug op de rollen die deze regels noemen. Er wordt eerst om bevestiging gevraagd."
          }
        },
        "pl" : {
          "stringUnit" : {
