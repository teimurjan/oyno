    "Sign in so your printers, spools and orders are on every device you work from — the phone at the machine and the laptop at the desk." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlas se, ať máš tiskárny, cívky a objednávky na každém zařízení, ze kterého pracuješ — na telefonu u stroje i na notebooku u stolu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind, så dine printere, spoler og ordrer er på alle de enheder, du arbejder fra — telefonen ved maskinen og computeren ved skrivebordet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich an, damit Drucker, Spulen und Aufträge auf jedem Gerät sind, an dem du arbeitest — auf dem Telefon an der Maschine und auf dem Laptop am Schreibtisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión para tener tus impresoras, bobinas y pedidos en todos los dispositivos desde los que trabajas: el móvil junto a la máquina y el portátil en la mesa."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión para tener tus impresoras, carretes y pedidos en todos los dispositivos desde los que trabajas: el celular junto a la máquina y la laptop en el escritorio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu sisään, niin tulostimet, kelat ja tilaukset ovat jokaisella laitteella, jolta työskentelet — puhelimessa koneen vieressä ja kannettavassa työpöydällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous pour retrouver vos imprimantes, bobines et commandes sur tous les appareils depuis lesquels vous travaillez : le téléphone devant la machine et l’ordinateur au bureau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi per avere stampanti, bobine e ordini su ogni dispositivo da cui lavori: il telefono davanti alla macchina e il portatile alla scrivania."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg inn så printere, spoler og ordrer er på hver enhet du jobber fra — telefonen ved maskinen og maskinen på pulten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in zodat je printers, spoelen en bestellingen op elk apparaat staan waarop je werkt — de telefoon bij de machine en de laptop op het bureau."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się, żeby drukarki, szpule i zamówienia były na każdym urządzeniu, na którym pracujesz — na telefonie przy maszynie i na laptopie przy biurku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre para ter suas impressoras, bobinas e pedidos em todo aparelho de onde você trabalha — o telefone na frente da máquina e o notebook na mesa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sessão para ter as suas impressoras, bobinas e encomendas em todos os dispositivos onde trabalha — o telemóvel junto à máquina e o portátil na secretária."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите, чтобы принтеры, катушки и заказы были на всех устройствах, с которых вы работаете: на телефоне у принтера и на ноутбуке за столом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in så att dina skrivare, spolar och ordrar finns på varje enhet du jobbar från — telefonen vid maskinen och datorn vid skrivbordet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazıcılarınız, makaralarınız ve siparişleriniz çalıştığınız her cihazda olsun diye giriş yapın — makinenin başındaki telefonda ve masadaki dizüstünde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увійдіть, щоб принтери, котушки й замовлення були на всіх пристроях, з яких ви працюєте: на телефоні біля принтера й на ноутбуці за столом."
          }
        }
      }
    },
