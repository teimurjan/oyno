    "That tag belongs to another spool. Bind it to this one by writing it again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten tag patří jiné cívce. Přiřadíš ho k téhle tím, že ho zapíšeš znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det tag hører til en anden spole. Knyt det til denne ved at skrive det igen."
