    "Its price and draw become an hourly cost on every quote." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z její ceny a příkonu se stane hodinový náklad v každé kalkulaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dens pris og forbrug bliver til en timepris på hvert tilbud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Preis und sein Verbrauch werden in jeder Kalkulation zu Kosten pro Stunde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su precio y su consumo se convierten en un coste por hora en cada presupuesto."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su precio y su consumo se convierten en un costo por hora en cada cotización."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen hinnasta ja virrankulutuksesta tulee tuntikustannus jokaiseen tarjoukseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son prix et sa consommation deviennent un coût horaire sur chaque devis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo prezzo e il suo consumo diventano un costo orario in ogni preventivo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisen og forbruket blir til en timekostnad i hvert tilbud."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De prijs en het verbruik worden op elke offerte een kostprijs per uur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jej cena i pobór mocy stają się kosztem godzinowym w każdej wycenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O preço e o consumo dela viram um custo por hora em cada orçamento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O preço e o consumo dela tornam-se um custo por hora em cada orçamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его цена и мощность превращаются в стоимость часа в каждом расчёте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess pris och effekt blir en timkostnad i varje offert."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyatı ve güç tüketimi her teklifte saatlik bir maliyete dönüşür."
