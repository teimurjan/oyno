    "Sign in so your plan and your planet stay with you, and a subscription bought on the web finds you here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich an, damit dein Plan und dein Planet bei dir bleiben und ein im Web gekauftes Abo auch hier gilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión para que tu plan y tu planeta vayan contigo, y para que una suscripción comprada en la web se active aquí."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión para que tu plan y tu planeta se queden contigo, y para que aquí aparezca la suscripción que hayas comprado en la web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous pour garder votre programme et votre planète, et retrouver ici un abonnement acheté sur le web."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi per tenere con te il tuo piano e il tuo pianeta, e per ritrovare qui un abbonamento acquistato sul web."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in, dan blijven je plan en je planeet bewaard. Een abonnement dat je online hebt gekocht, vind je hier ook terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się, by plan i planeta zostały z tobą, a subskrypcja kupiona na stronie znalazła cię tutaj."
          }
        },
        "pt-BR" : {
