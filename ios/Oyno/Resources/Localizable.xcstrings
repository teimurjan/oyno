    "Face down is fine. We'll buzz at the end." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg das Handy ruhig umgedreht hin. Am Ende vibriert es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes dejarlo boca abajo. Vibrará al terminar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes dejarlo boca abajo. Vibrará al final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez-le écran contre la table, sans souci. Il vibrera à la fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi capovolgere il telefono. Alla fine vibrerà."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg je telefoon gerust omgekeerd neer. Aan het eind trilt hij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz odłożyć telefon ekranem w dół. Na koniec zawibruje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode deixar com a tela para baixo. O celular vibra no final."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно положить экраном вниз. В конце телефон завибрирует."
