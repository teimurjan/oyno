            "value" : "Probier es mit „ruhig“, „Bewegung“ oder „Schlafenszeit“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba con “tranquilo”, “pelota” o “antes de dormir”."
