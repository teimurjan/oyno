    "Allow camera access in iOS Settings, or type the details in by hand — every field the scanner fills is editable anyway." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povol přístup ke kameře v Nastavení iOS, nebo údaje napiš ručně — všechno, co skener vyplní, se stejně dá upravit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv adgang til kameraet i iOS-indstillingerne, eller tast oplysningerne ind i hånden — alt det, scanneren udfylder, kan alligevel rettes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Kamerazugriff in den iOS-Einstellungen oder tipp die Angaben von Hand ein — alles, was der Scanner ausfüllt, lässt sich ohnehin ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a la cámara en los Ajustes de iOS, o escribe los datos a mano: todo lo que rellena el escáner se puede editar igualmente."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a la cámara en Configuración de iOS, o escribe los datos a mano: todo lo que llena el escáner se puede editar de todos modos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli kameran käyttö iOSin asetuksissa tai kirjoita tiedot käsin — kaikkea skannerin täyttämää voi joka tapauksessa muokata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès à l’appareil photo dans les Réglages iOS, ou saisissez les informations à la main — tout ce que le scanner remplit reste modifiable de toute façon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l’accesso alla fotocamera nelle Impostazioni di iOS, oppure inserisci i dati a mano: tutto quello che compila lo scanner resta comunque modificabile."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi kameraet tilgang i iOS-innstillingene, eller skriv inn detaljene for hånd — alt skanneren fyller inn kan uansett endres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef de camera toegang in de iOS-instellingen, of typ de gegevens met de hand in — alles wat de scanner invult, kun je toch aanpassen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól na dostęp do aparatu w Ustawieniach iOS albo wpisz dane ręcznie — wszystko, co wypełnia skaner, i tak można poprawić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libere o acesso à câmera nos Ajustes do iOS, ou digite os dados na mão — tudo que o scanner preenche dá para editar de qualquer jeito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso à câmara nas Definições do iOS, ou escreva os dados à mão — tudo o que o leitor preenche é editável de qualquer forma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к камере в настройках iOS или введите данные вручную — всё, что заполняет сканер, всё равно можно править."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge kameran åtkomst i iOS-inställningarna, eller skriv in uppgifterna för hand — allt skannern fyller i går ändå att ändra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS Ayarlar’dan kameraya izin verin ya da bilgileri elle yazın — tarayıcının doldurduğu her şey zaten düzenlenebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвольте доступ до камери в налаштуваннях iOS або введіть дані вручну — усе, що заповнює сканер, усе одно можна виправити."
          }
        }
      }
    },
