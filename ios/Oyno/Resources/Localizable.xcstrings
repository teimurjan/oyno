    "Markup, reprint reserve and waste start at sensible defaults. Change any of them later in Profile." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přirážka, rezerva na dotisk a rezerva na odpad začínají na rozumných hodnotách. Kdykoli je změníš v Profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avance, reserve til genprint og spildtillæg starter på fornuftige værdier. Du kan ændre dem når som helst under Profil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufschlag, Reserve für Nachdrucke und Abfallzuschlag starten mit sinnvollen Werten. Du kannst sie jederzeit unter Profil ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El recargo, la reserva para reimpresión y la merma parten de valores razonables. Puedes cambiarlos cuando quieras en Perfil."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El margen aplicado, la reserva para reimpresión y la merma empiezan con valores razonables. Puedes cambiarlos cuando quieras en Perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katelisä, uusintatulostusvaraus ja hukkavara alkavat järkevistä arvoista. Voit muuttaa niitä milloin tahansa kohdassa Profiili."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La majoration, la provision pour réimpression et le taux de rebut partent de valeurs raisonnables. Modifiez-les à tout moment dans Profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricarico, riserva per ristampe e scarto partono da valori sensati. Puoi cambiarli quando vuoi in Profilo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påslag, reserve for omprint og svinnpåslag starter på fornuftige verdier. Du kan endre dem når som helst under Profil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opslag, reservering voor herprints en afvalmarge beginnen op redelijke waarden. Je kunt ze later altijd aanpassen in Profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narzut, rezerwa na powtórki i zapas na odpad startują z rozsądnych wartości. Zmienisz je w każdej chwili w Profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markup, reserva para reimpressão e perda começam com valores razoáveis. Altere qualquer um deles depois em Perfil."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A margem aplicada, a reserva para reimpressão e a perda começam com valores razoáveis. Pode alterá-los mais tarde em Perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наценка, резерв на перепечатку и запас на отходы стоят на разумных значениях. Их можно поменять в любой момент в Профиле."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påslag, reserv för omutskrifter och spillpåslag börjar på rimliga värden. Ändra dem när du vill under Profil."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kâr payı, yeniden baskı payı ve fire payı makul değerlerle başlar. Bunları istediğiniz zaman Profil’den değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Націнка, резерв на передрук і запас на відходи мають розумні значення. Їх можна змінити будь-коли в Профілі."
          }
        }
      }
    },
