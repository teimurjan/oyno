<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24765" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="Lnc-00-vcr">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24743"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="Lnc-00-scn">
            <objects>
                <viewController id="Lnc-00-vcr" sceneMemberID="viewController">
                    <!-- The resting mark, centred on the brand blue. SplashScreen's first frame
                         is the same still — same AppMark, 200pt, same centre, on Palette.accent
                         — so the storyboard-to-SwiftUI handoff is the mark not moving. Keep the
                         height (200), the colour, and the 617:637 aspect in step with the
                         SplashScreen.Nozzle constants and Palette.accent. -->
                    <view key="view" contentMode="scaleToFill" id="Lnc-00-vew">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="AppMark" translatesAutoresizingMaskIntoConstraints="NO" id="Lnc-00-mrk">
                                <rect key="frame" x="99.666666666666671" y="351" width="193.66666666666657" height="200"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="200" id="Lnc-01-cst"/>
                                    <constraint firstAttribute="width" secondItem="Lnc-00-mrk" secondAttribute="height" multiplier="617:637" id="Lnc-02-cst"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="Lnc-00-saf"/>
                        <color key="backgroundColor" red="0.05882352941176471" green="0.3843137254901961" blue="0.996078431372549" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="Lnc-00-mrk" firstAttribute="centerX" secondItem="Lnc-00-saf" secondAttribute="centerX" id="Lnc-03-cst"/>
                            <constraint firstItem="Lnc-00-mrk" firstAttribute="centerY" secondItem="Lnc-00-saf" secondAttribute="centerY" id="Lnc-04-cst"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="Lnc-00-rsp" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="AppMark" width="1234" height="1274"/>
    </resources>
</document>
